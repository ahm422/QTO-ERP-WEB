{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
	"name": "qto-erp-web",
	"main": "cf-worker.ts",
	"compatibility_date": "2026-07-03",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	"routes": [
		{ "pattern": "qtoerp.com/*", "zone_name": "qtoerp.com" },
		{ "pattern": "www.qtoerp.com/*", "zone_name": "qtoerp.com" }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "qto-erp-web"
		},
		{
			"binding": "CHATBOT",
			"service": "qto-erp-chatbot"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"AUTH_URL": "https://qtoerp.com",
		"EMAIL_FROM": "QTO ERP <noreply@qtoerp.com>",
		"ADMIN_NOTIFICATION_EMAIL": "you@example.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "qto-erp-db-production",
			"database_id": "YOUR_D1_DATABASE_ID",
			"migrations_dir": "drizzle/migrations"
		},
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "qto-erp-db-production",
			"database_id": "YOUR_D1_DATABASE_ID",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "qto-erp-media-production"
		},
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "qto-erp-next-cache-production"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		}
	],
	"env": {
		"staging": {
			"name": "qto-erp-web-staging",
			"workers_dev": true,
			"routes": [],
			"triggers": {
				"crons": ["0 3 * * *"]
			},
			"vars": {
				"AUTH_URL": "https://qto-erp-web-staging.your-subdomain.workers.dev",
				"EMAIL_FROM": "QTO ERP Staging <noreply@qtoerp.com>",
				"ADMIN_NOTIFICATION_EMAIL": "you@example.com"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "qto-erp-web-staging"
				},
				{
					"binding": "CHATBOT",
					"service": "qto-erp-chatbot-staging"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "qto-erp-db-staging",
					"database_id": "YOUR_D1_DATABASE_ID",
					"migrations_dir": "drizzle/migrations"
				},
				{
					"binding": "NEXT_TAG_CACHE_D1",
					"database_name": "qto-erp-db-staging",
					"database_id": "YOUR_D1_DATABASE_ID",
					"migrations_dir": "drizzle/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA_BUCKET",
					"bucket_name": "qto-erp-media-staging"
				},
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "qto-erp-next-cache-staging"
				}
			],
			"send_email": [
				{
					"name": "EMAIL",
					"remote": true
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["DOQueueHandler"]
				}
			]
		}
	}
}
