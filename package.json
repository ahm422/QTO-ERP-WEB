{
  "name": "qto-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev:workers": "opennextjs-cloudflare build && wrangler dev --persist-to=./.wrangler/state --ip 127.0.0.1",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply qto-erp-db-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply qto-erp-db-production --remote",
    "db:migrate:staging": "wrangler d1 migrations apply qto-erp-db-staging --remote --env staging",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:create-admin": "tsx --env-file=.env scripts/create-admin.ts local",
    "db:create-admin:staging": "tsx --env-file=.env scripts/create-admin.ts staging",
    "db:create-admin:remote": "tsx --env-file=.env scripts/create-admin.ts production",
    "db:seed:staging": "tsx --env-file=.env scripts/seed-remote.ts staging",
    "db:seed:remote": "tsx --env-file=.env scripts/seed-remote.ts production",
    "resend:domains": "tsx --env-file=.env scripts/resend-domains.ts",
    "stripe:check": "tsx --env-file=.env scripts/stripe-check.ts",
    "stripe:webhook-test": "tsx --env-file=.env scripts/stripe-webhook-test.ts",
    "verify:jwt": "tsx --env-file=.env scripts/verify-jwt.ts",
    "cf:types": "wrangler types --env-interface CloudflareEnv",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:wrangler": "OPEN_NEXT_DEPLOY=true CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID WRANGLER_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID wrangler deploy",
    "deploy:wrangler:staging": "OPEN_NEXT_DEPLOY=true CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID WRANGLER_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID wrangler deploy --env staging",
    "deploy": "opennextjs-cloudflare build && npm run deploy:wrangler",
    "deploy:staging": "opennextjs-cloudflare build && npm run deploy:wrangler:staging"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.34.3",
    "jose": "^6.2.3",
    "lucide-react": "^0.575.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-email": "^6.5.0",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.107.0"
  }
}
