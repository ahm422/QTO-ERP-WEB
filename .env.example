# Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_PEPPER=""

# App base URL for Stripe redirect URLs (must match your dev server port)
# npm run dev → http://localhost:3000
# npm run dev:workers / preview → http://localhost:8787 (also set in .dev.vars for wrangler)
AUTH_URL="http://localhost:3000"

# Seed admin user (do not commit real passwords; set in local .env only)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-in-local-env"

# Transactional email — Cloudflare Email Sending (Worker binding env.EMAIL) by default.
# Use npm run dev:workers (or wrangler) so the EMAIL binding is available.
# EMAIL_PROVIDER=cloudflare|resend (default: cloudflare). Set resend only for legacy fallback.
EMAIL_PROVIDER="cloudflare"
# Optional legacy Resend fallback (only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
# Production / staging (verified @qtoerp.com): QTO ERP <noreply@qtoerp.com>
EMAIL_FROM="QTO ERP <noreply@qtoerp.com>"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs (price_...), NOT product IDs (prod_...)
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_YEARLY=""
