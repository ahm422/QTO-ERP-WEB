# PostgreSQL connection string (Coolify / Docker: use internal Postgres host on the app network)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qto_erp?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# App URL for Auth.js and Stripe redirect URLs (must match your dev server port)
AUTH_URL="http://localhost:3000"

# Seed admin user (do not commit real passwords; set in local .env only)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-in-local-env"

# Resend (https://resend.com)
RESEND_API_KEY=""
# Optional: domain id from Resend dashboard or `npm run resend:domains -- list`
RESEND_DOMAIN_ID=""
# Production (after DNS verified): QTO ERP <noreply@yourdomain.com>
# Dev sandbox: QTO ERP <onboarding@resend.dev>
EMAIL_FROM="QTO ERP <noreply@qto-erp.com>"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs (price_...), NOT product IDs (prod_...)
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_YEARLY=""

# Garage S3-compatible object storage (demo videos)
GARAGE_ENDPOINT="http://127.0.0.1:3900"
GARAGE_REGION="garage"
GARAGE_ACCESS_KEY_ID=""
GARAGE_SECRET_ACCESS_KEY=""
GARAGE_BUCKET="qto-erp-demo-videos"
# Optional presign TTLs (seconds)
GARAGE_PRESIGN_UPLOAD_EXPIRES_SECONDS="900"
GARAGE_PRESIGN_GET_EXPIRES_SECONDS="3600"
