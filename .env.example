# Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_PEPPER=""

# App base URL for Stripe redirect URLs (must match your dev server port)
# npm run dev → http://localhost:3000
# npm run dev:workers / preview → http://localhost:8787 (also set in .dev.vars for wrangler)
AUTH_URL="http://localhost:3000"

# Seed admin user (do not commit real passwords; set in local .env only)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-in-local-env"

# Transactional email — Cloudflare Email Sending only by default.
# Production / staging / npm run dev:workers: Worker binding env.EMAIL (wrangler send_email).
# Plain npm run dev: EMAIL binding is not present — use the Email Sending REST API:
#   Create a token with Email Sending permission → https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=""
# Optional override (defaults to the wrangler.jsonc account_id)
# CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
# EMAIL_PROVIDER=cloudflare|resend (default: cloudflare). Set resend only for legacy fallback.
EMAIL_PROVIDER="cloudflare"
# Optional legacy Resend fallback (only when EMAIL_PROVIDER=resend — never auto-used)
RESEND_API_KEY=""
# Production / staging (verified @qtoerp.com): QTO ERP <noreply@qtoerp.com>
EMAIL_FROM="QTO ERP <noreply@qtoerp.com>"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Stripe (https://dashboard.stripe.com/test/apikeys)
# Deployed envs: STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must be set as Worker
# secrets (`wrangler secret put ... [--env staging]`), not build-time vars.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs (price_...), NOT product IDs (prod_...)
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_YEARLY=""

# Optional. Free-trial length in days for /api/pricing/trial (default 14)
# TRIAL_PERIOD_DAYS="14"
