{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "qto-erp-chatbot",
	"account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-03",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"vars": {},
	"env": {
		"staging": {
			"name": "qto-erp-chatbot-staging"
		}
	}
}
